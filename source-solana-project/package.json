    "@pythnetwork/hermes-client": "^1.0.1",
    "@react-three/fiber": "^8.17.14",
    "@shadergradient/react": "^2.4.20",
    "@solana/spl-governance": "^0.3.28",
    "@solana/spl-token": "^0.4.6",
