{
  "name": "gmx-solana-interface",
  "private": true,
  "version": "2.14.0",
  "type": "module",
  "scripts": {
    "start": "pnpm -w build-client && pnpm dev --mode dev",
    "start:quiet-price-guard": "pnpm -w build-client && VITE_SUPPRESS_PRICE_DEVIATION_LOGS=true pnpm dev",
    "start:prod": "tsx scripts/startWithRpcProxy.ts prod production",
    "start:beta": "tsx scripts/startWithRpcProxy.ts beta beta",
    "start:gmtrade": "tsx scripts/startWithRpcProxy.ts prod gmtrade",
    "start:test": "tsx scripts/startWithRpcProxy.ts nightly test",
    "start:devnet": "tsx scripts/startWithRpcProxy.ts devnet devnet",
    "start:preview": "tsx scripts/startWithRpcProxy.ts nightly preview",
    "start:preview2": "VITE_FORCE_GRADUATED_FLAGS=true tsx scripts/startWithRpcProxy.ts nightly preview",
    "dev": "vite",
    "build": "pnpm -w build-client && vite build",
    "build:backup": "pnpm -w build-client && vite build --mode backup",
    "build:dev": "pnpm -w build-client && vite build --mode dev",
    "build:test": "pnpm -w build-client && vite build --mode test",
    "build:preview": "pnpm -w build-client && pnpm build --mode preview",
    "build:beta": "pnpm -w build-client && pnpm build --mode beta",
    "build:gmtrade": "pnpm -w build-client && pnpm build --mode gmtrade",
    "build:nightly": "pnpm -w build-client && vite build --mode nightly",
    "build:devnet": "pnpm -w build-client && pnpm build --mode devnet",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy:cf-nightly": "pnpm build:nightly && npx wrangler pages deploy dist --project-name=gmtrade-interface-dev",
    "deploy:cf-devnet": "pnpm build:devnet && pnpm cf-upload:devnet",
    "cf-upload:nightly": "pnpm exec wrangler pages deploy dist --project-name=gmtrade-interface-dev",
    "cf-upload:devnet": "pnpm exec wrangler pages deploy dist --project-name=gmtrade-interface-devnet",
    "deploy:cf-beta": "pnpm build && npx wrangler pages deploy dist --project-name=gmtrade-interface-beta",
    "deploy:cf": "pnpm build && npx wrangler pages deploy dist --project-name=gmtrade-interface",
    "extract": "lingui extract",
    "compile": "lingui compile --typescript",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "translate": "tsx scripts/autoTranslate.ts",
    "nightly:flags": "tsx scripts/nightlyFlags.ts"
  },
  "dependencies": {
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0",
    "@apollo/client": "^4.0.9",
