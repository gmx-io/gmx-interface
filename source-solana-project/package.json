    "react-helmet-async": "^2.0.4",
    "react-icons": "^5.1.0",
    "react-loading-skeleton": "^3.5.0",
    "react-remove-scroll": "^2.5.9",
    "react-router-dom": "^6.23.0",
    "react-router-hash-link": "^2.4.3",
    "react-toastify": "^10.0.5",
    "react-ts-tradingview-widgets": "^1.2.4",
    "react-use": "^17.5.0",
    "recharts": "^2.15.0",
    "reselect": "^5.1.0",
    "swiper": "^11.2.8",
    "swr": "^2.2.5",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1",
    "tweetnacl": "^1.0.3",
    "use-context-selector": "^1.4.4",
    "use-immer": "^0.9.0",
    "usehooks-ts": "^3.1.0",
    "utc": "link:dayjs/plugin/utc",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@lingui/cli": "^4.11.2",
    "@lingui/conf": "^4.10.0",
    "@lingui/core": "^4.10.0",
    "@lingui/loader": "^4.10.0",
    "@lingui/macro": "^4.10.0",
    "@lingui/vite-plugin": "^4.10.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/bs58": "^4.0.4",
    "@types/dompurify": "^3.2.0",
    "@types/heap": "^0.2.34",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "date-fns-tz": "^3.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jest": "^29.7.0",
    "postcss": "^8.4.49",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "sass": "^1.75.0",
    "stylelint": "^16.9.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "tailwindcss": "3.4.4",
    "ts-jest": "^29.2.5",
    "ts-migrate": "^0.1.35",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vite-plugin-node-polyfills": "^0.21.0",
    "vite-plugin-static-copy": "^1.0.4",
