    "animate.css": "^4.1.1",
    "camera-controls": "^3.1.2",
    "classnames": "^2.5.1",
    "cryptocurrency-icons": "^0.18.1",
    "date-fns": "2.27.0",
    "date-holidays": "^3.26.9",
    "dayjs": "^1.11.13",
    "dompurify": "^3.4.2",
    "framer-motion": "^11.1.7",
    "gmsol": "workspace:*",
    "graphology": "^0.25.4",
    "graphology-shortest-path": "^2.1.0",
    "graphql": "^16.12.0",
