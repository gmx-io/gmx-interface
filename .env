GENERATE_SOURCEMAP=false
VITE_APP_UI_FEE_RECEIVER=0xff00000000000000000000000000000000000001
VITE_GMX_SOLANA_API_ENDPOINT=https://gmtrade-web-backend.gmtrade.xyz

# Remote Solana RPC endpoint. Production and other non-local builds use this URL directly.
VITE_APP_SOLANA_RPC_URL=https://rpc-1.gmtrade.xyz/
# Optional local proxy URL for the Solana RPC client. `yarn start` / `yarn start-app`
# inject http://localhost:${LOCAL_RPC_PROXY_PORT}/ when this is unset.
# VITE_APP_LOCAL_RPC_PROXY_ENDPOINT=http://localhost:9010/
# Port for the local Solana RPC proxy. Keep this off the Vite ports (3010 / 3011).
LOCAL_RPC_PROXY_PORT=9010
# Upstream Solana RPC endpoint that the local proxy forwards to.
RPC_PROXY_TARGET=https://rpc-1.gmtrade.xyz
# Target environment for the local RPC proxy. Placeholder: currently always nightly.
RPC_PROXY_ENV=nightly
# Upstream Origin/Referer the local proxy sends. Nightly placeholder.
RPC_PROXY_ORIGIN=https://nightly.gmtrade.xyz
