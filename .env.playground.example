# Reference names for the tracked .env.playground.local playground configuration.
# These values are embedded in browser assets; they are not server-side secrets.
# The same key may be used for multiple purposes if its app supports the required networks.
PLAYGROUND_ALCHEMY_DEVELOPMENT_KEY=
PLAYGROUND_ALCHEMY_FALLBACK_KEY=
PLAYGROUND_ALCHEMY_LARGE_ACCOUNT_KEY=
PLAYGROUND_ALCHEMY_EXPRESS_KEY=
