{
  "extends": "../../sdk/tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationDir": null,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "../../playwright-regression.config.ts",
    "../../playwright-funded-preflight.config.ts",
    "../../playwright-funded-harness.config.ts",
    "../../viem-override.d.ts"
  ],
  "exclude": ["funded/**"]
}
